    def _open_schedule_editor(self) -> None:
        if self.schedule_window is not None and self.schedule_window.winfo_exists():
            self.schedule_window.lift()
            return

        window = tk.Toplevel(self.root)
        window.title("Multi-frequency temperature schedule")
        window.transient(self.root)
        window.resizable(False, False)
        self.schedule_window = window

        ttk.Label(
            window,
            text="Steps run in order; phase is continuous across period changes.",
            padding=(10, 8),
        ).pack(anchor="w")
        tree = ttk.Treeview(
            window,
            columns=("duration", "mean", "amplitude", "period"),
            show="headings",
            height=MAX_SCHEDULE_STEPS,
            selectmode="extended",
        )
        self.schedule_tree = tree
        headings = (
            ("duration", "Duration (s)", 105),
            ("mean", "Mean (°C)", 100),
            ("amplitude", "Amplitude (°C)", 110),
            ("period", "Period (s)", 100),
        )
        for column, title, width in headings:
            tree.heading(column, text=title)
            tree.column(column, width=width, anchor="center", stretch=False)
        tree.pack(fill=tk.X, padx=10)
        tree.bind("<Double-1>", self._edit_schedule_cell)
        self._refresh_schedule_tree()

        buttons = ttk.Frame(window, padding=10)
        buttons.pack(fill=tk.X)
        ttk.Button(buttons, text="Add step", command=self._add_schedule_step).pack(
            side=tk.LEFT
        )
        ttk.Button(
            buttons, text="Remove selected", command=self._remove_schedule_steps
        ).pack(side=tk.LEFT, padx=(5, 0))
        ttk.Button(
            buttons, text="Send schedule", command=self._send_schedule
        ).pack(side=tk.LEFT, padx=(15, 0))
        ttk.Button(buttons, text="Close", command=self._close_schedule_editor).pack(
            side=tk.RIGHT
        )
        window.protocol("WM_DELETE_WINDOW", self._close_schedule_editor)

    def _close_schedule_editor(self) -> None:
        self._capture_schedule_tree()
        if self.schedule_window is not None:
            self.schedule_window.destroy()
        self.schedule_window = None
        self.schedule_tree = None

    def _capture_schedule_tree(self) -> list[ScheduleStep] | None:
        tree = self.schedule_tree
        if tree is None or not tree.winfo_exists():
            return self.schedule_steps
        try:
            steps = [
                ScheduleStep(*(float(value) for value in tree.item(item, "values")))
                for item in tree.get_children()
            ]
        except (TypeError, ValueError):
            return None
        self.schedule_steps = steps
        return steps

    def _refresh_schedule_tree(self) -> None:
        tree = self.schedule_tree
        if tree is None or not tree.winfo_exists():
            return
        for item in tree.get_children():
            tree.delete(item)
        for index, step in enumerate(self.schedule_steps):
            tree.insert(
                "",
                tk.END,
                iid=f"step-{index}",
                values=(
                    f"{step.duration_s:g}",
                    f"{step.mean_c:g}",
                    f"{step.amplitude_c:g}",
                    f"{step.period_s:g}",
                ),
            )
        self._highlight_schedule_step()

    def _edit_schedule_cell(self, event: tk.Event) -> None:
        tree = self.schedule_tree
        if tree is None:
            return
        item = tree.identify_row(event.y)
        column_id = tree.identify_column(event.x)
        if not item or column_id == "#0":
            return
        bounds = tree.bbox(item, column_id)
        if not bounds:
            return
        x, y, width, height = bounds
        column_index = int(column_id[1:]) - 1
        values = list(tree.item(item, "values"))
        editor = ttk.Entry(tree)
        editor.place(x=x, y=y, width=width, height=height)
        editor.insert(0, values[column_index])
        editor.select_range(0, tk.END)
        editor.focus_set()

        def finish(_event=None) -> None:
            if not editor.winfo_exists():
                return
            values[column_index] = editor.get().strip()
            tree.item(item, values=values)
            editor.destroy()
            self._capture_schedule_tree()

        editor.bind("<Return>", finish)
        editor.bind("<KP_Enter>", finish)
        editor.bind("<FocusOut>", finish)

    def _add_schedule_step(self) -> None:
        steps = self._capture_schedule_tree()
        if steps is None:
            messagebox.showerror("Invalid schedule", "Finish editing the current row.")
            return
        if len(steps) >= MAX_SCHEDULE_STEPS:
            messagebox.showerror(
                "Schedule is full", f"At most {MAX_SCHEDULE_STEPS} steps are supported."
            )
            return
        self.schedule_steps = steps + [
            ScheduleStep(60.0, self.config.setpoint_c, 2.0, 30.0)
        ]
        self._refresh_schedule_tree()

    def _remove_schedule_steps(self) -> None:
        tree = self.schedule_tree
        if tree is None:
            return
        selected = set(tree.selection())
        if not selected:
            return
        try:
            self.schedule_steps = [
                ScheduleStep(*(float(value) for value in tree.item(item, "values")))
                for item in tree.get_children()
                if item not in selected
            ]
        except (TypeError, ValueError):
            messagebox.showerror("Invalid schedule", "Finish editing the current row.")
            return
        self._refresh_schedule_tree()

    def _send_schedule(self) -> None:
        if self.arduino_serial is None:
            messagebox.showerror(
                "Connect to the Arduino",
                "Connect to the Arduino before sending a schedule.",
            )
            return
        steps = self._capture_schedule_tree()
        if steps is None:
            messagebox.showerror("Invalid schedule", "All schedule fields must be numeric.")
            return
        try:
            validate_schedule(steps)
        except ValueError as error:
            messagebox.showerror("Invalid schedule", str(error))
            return

        if self.running:
            self._stop_running()
        try:
            self.arduino_serial.write(
                (serialize_schedule(steps) + "\n").encode("ascii")
            )
        except (serial.SerialException, OSError) as error:
            self._handle_arduino_error(error)
            return
        self.arduino_status.set(
            f"Schedule upload sent ({len(steps)} steps); waiting for Arduino validation"
        )
        self.schedule_upload_pending = True
        self.schedule_step_status.set(
            f"Pending Arduino validation: {len(steps)} steps"
        )
        self._refresh_schedule_tree()

    def _highlight_schedule_step(self) -> None:
        tree = self.schedule_tree
        if tree is None or not tree.winfo_exists():
            return
        item = f"step-{self.arduino_schedule_step}"
        if self.arduino_schedule_step >= 0 and tree.exists(item):
            tree.selection_set(item)
            tree.focus(item)
            tree.see(item)
        else:
            tree.selection_remove(tree.selection())

    def _update_schedule_display(self, telemetry: ArduinoTelemetry) -> None:
        self.arduino_schedule_step = telemetry.schedule_step
        if telemetry.schedule_step < 0:
            self.schedule_step_status.set("No active schedule")
        elif telemetry.operating_state == "COMPLETE":
            self.schedule_step_status.set(
                f"Complete | final step {telemetry.schedule_step + 1} | "
                f"mean {telemetry.step_mean_c:.2f} °C | "
                f"amplitude {telemetry.step_amplitude_c:.2f} °C | "
                f"period {telemetry.step_period_s:.2f} s"
            )
        else:
            self.schedule_step_status.set(
                f"Step {telemetry.schedule_step + 1} | "
                f"{telemetry.step_duration_ms / 1000.0:g} s | "
                f"mean {telemetry.step_mean_c:.2f} °C | "
                f"amplitude {telemetry.step_amplitude_c:.2f} °C | "
                f"period {telemetry.step_period_s:.2f} s | "
                f"setpoint {telemetry.setpoint_c:.2f} °C"
            )
        self._highlight_schedule_step()

    def _render_math_symbol(self, expression: str) -> tk.PhotoImage:
        """Render a control symbol with the same math engine as the plots."""

        buffer = io.BytesIO()
        with self.matplotlib.rc_context({"savefig.transparent": True}):
            self.math_to_image(
                f"${expression}$",
                buffer,
                prop=self.FontProperties(size=13.5),
                dpi=120,
                format="png",
                color="black",
            )
        encoded = base64.b64encode(buffer.getvalue()).decode("ascii")
        image = tk.PhotoImage(data=encoded)
        self.math_symbol_images.append(image)
        return image

    def _live_symbol_image(self, expression: str) -> tk.PhotoImage:
        """Return a cached MathText image for a live-value symbol."""

        if expression not in self.live_symbol_cache:
            self.live_symbol_cache[expression] = self._render_math_symbol(expression)
        return self.live_symbol_cache[expression]

    def _set_live_symbol(self, key: str, expression: str) -> None:
        """Change a live-row symbol when the selected process model changes."""

        self.live_symbol_widgets[key].configure(
            image=self._live_symbol_image(expression)
        )

    def _read_config(self) -> ModelConfig:
        values = {
            attribute: float(self.entries[attribute].get())
            for _symbol, _label, attribute, _units, _low, _high, _resolution
            in self.FIELD_SPECS
        }
        values["anti_windup"] = self.anti_windup.get()
        config = replace(self.defaults, **values)
        config = replace(config, feedforward_table=self.feedforward_table)
        if self.parameter_source.get() == "measured":
            derived = constants_from_measurements(
                config.measured_cooling_chi_c_per_pwm,
                config.measured_heating_chi_c_per_pwm,
                config.measured_tau_s,
                config.tec_voltage_v,
                config.tec_resistance_ohm,
            )
            config = replace(
                config,
                total_capacitance_j_per_c=derived.total_capacitance_j_per_c,
                heat_loss_w_per_c=derived.heat_loss_w_per_c,
                tec_power_w_per_pwm=derived.cooling_power_w_per_pwm,
                heating_to_cooling_ratio=derived.heating_to_cooling_ratio,
            )
            self._show_derived_constants(config)
        validate_config(config)
        return config

    def _show_derived_constants(self, config: ModelConfig) -> None:
        """Keep the locked direct-constant fields synchronized with measurements."""

        if self.syncing_derived_fields:
            return
        self.syncing_derived_fields = True
        try:
            for attribute in (
                "total_capacitance_j_per_c",
                "heat_loss_w_per_c",
                "tec_power_w_per_pwm",
                "heating_to_cooling_ratio",
            ):
                self.entries[attribute].set(getattr(config, attribute))
        finally:
            self.syncing_derived_fields = False

    def _reset_experiment(self) -> None:
        if self.running:
            self._stop_running()
        self.arduino_integral_error_c_s = 0.0
        try:
            self.config = self._read_config()
        except ValueError as error:
            messagebox.showerror("Check the model parameters", str(error))
            return
        self.state = ModelState(
            0.0, self.config.initial_c, self.config.initial_c, 0.0
        )
        self.times = [0.0]
        self.tec_temperatures = [self.config.initial_c]
        self.measured_temperatures = [self.config.initial_c]
        self.hardware_setpoints = [self.config.setpoint_c]
        self.rod_temperatures = [[math.nan] for _ in range(5)]
        self.p_terms = [0.0]
        self.i_terms = [0.0]
        self.commands = [0.0]
        target_temperature = controller_target_temperature(
            self.config, self.controller_mode.get()
        )
        self.errors = [target_temperature - self.config.initial_c]
        self.latest = self._current_result()
        self.running = False
        self.run_button_text.set("Resume")
        self._draw()

    def _current_result(self) -> StepResult:
        error, p_term, i_term, command, saturated = controller_command(
            self.state,
            self.config,
            self.process_mode.get(),
            self.controller_mode.get(),
            advance_integral=False,
        )
        return StepResult(
            self.state.time_s,
            self.state.tec_temperature_c,
            self.state.measured_temperature_c,
            error,
            p_term,
            i_term,
            command,
            saturated,
        )

    def _change_process(self, _event=None) -> None:
        self._reset_experiment()

    def _change_controller(self, _event=None) -> None:
        if self.run_mode.get() == "Arduino hardware" and self.running:
            self._stop_running()
        self.state.integral_error_c_s = 0.0
        self.arduino_integral_error_c_s = 0.0
        if (
            self.controller_mode.get() == "raw_offset_sine"
            and self.feedforward_table is not None
        ):
            table_config = replace(
                self.config, feedforward_table=self.feedforward_table
            )
            self.diagnostic_ua_pwm.set(
                f"{feedforward_command(40.0, table_config):.2f}"
            )
        self.latest = self._current_result()
        self._draw()

    def _on_diagnostic_parameter_edit(self, *_args) -> None:
        if self.run_mode.get() == "Arduino hardware" and self.running:
            self._stop_running()
            self.arduino_status.set(
                "Diagnostic parameters changed; hardware paused. Validate and resume."
            )

    def _change_run_mode(self, _event=None) -> None:
        if self.running:
            self._stop_running()
        if self.run_mode.get() == "Arduino hardware":
            self.process_mode.set("one_lump")
            modes = (
                "open_loop", "feedforward", "p", "pi",
                "raw_sine", "raw_offset_sine",
            )
        else:
            modes = ("open_loop", "feedforward", "p", "pi")
        self.controller_mode_box.configure(values=modes)
        if self.controller_mode.get() not in modes:
            self.controller_mode.set(
                "pi" if self.run_mode.get() == "Arduino hardware" else "p"
            )
        self.arduino_integral_error_c_s = 0.0
        self.arduino_last_time_s = None
        self._reset_experiment()

    def _refresh_serial_ports(self) -> None:
        ports = [port.device for port in list_ports.comports()]
        self.serial_port_box.configure(values=ports)
        if self.serial_port_name.get() not in ports:
            self.serial_port_name.set(ports[0] if ports else "")
        self.arduino_status.set(
            "Arduino disconnected" if ports else "No serial ports found"
        )

    def _toggle_arduino_connection(self) -> None:
        if self.arduino_serial is not None:
            self._disconnect_arduino()
            return
        port_name = self.serial_port_name.get()
        if not port_name:
            messagebox.showerror(
                "Select an Arduino port",
                "Refresh the port list and select the Arduino port.",
            )
            return
        try:
            self.arduino_serial = serial.Serial(
                port_name, 9600, timeout=0, write_timeout=1
            )
            self.arduino_rx_buffer.clear()
            self.arduino_integral_error_c_s = 0.0
            self.arduino_last_time_s = None
            self.arduino_schedule_step = -1
            self.schedule_accepted = False
            self.schedule_upload_pending = False
            self.arduino_last_record_received_at = time.monotonic()
            self.arduino_missing_record_reported = False
            self.arduino_data_warning = ""
            ratio = measured_cooling_compensation_ratio(self.config)
            self.arduino_serial.write(
                f"ACTUATOR,PAUSED,pi,0,0,{ratio:.4f},0,0,0,0\n".encode("ascii")
            )
        except (serial.SerialException, OSError) as error:
            if self.arduino_serial is not None:
                self.arduino_serial.close()
                self.arduino_serial = None
            messagebox.showerror("Arduino connection failed", str(error))
            self.arduino_status.set(f"Connection failed: {error}")
            return
        self.serial_connect_button.configure(text="Disconnect")
        self.serial_port_box.configure(state="disabled")
        self.serial_refresh_button.configure(state="disabled")
        self.arduino_status.set(f"Connected to {port_name}; logging telemetry")

    def _disconnect_arduino(self) -> None:
        self.running = False
        self.run_button_text.set("Resume")
        connection = self.arduino_serial
        self.arduino_serial = None
        disconnect_error: Exception | None = None
        if connection is not None:
            try:
                ratio = measured_cooling_compensation_ratio(self.config)
                connection.write(
                    f"ACTUATOR,PAUSED,pi,0,0,{ratio:.4f},0,0,0,0\n".encode("ascii")
                )
            except (serial.SerialException, OSError) as error:
                disconnect_error = error
            try:
                connection.close()
            except (serial.SerialException, OSError) as error:
                if disconnect_error is None:
                    disconnect_error = error
        self.serial_connect_button.configure(text="Connect")
        self.serial_port_box.configure(state="readonly")
        self.serial_refresh_button.configure(state="normal")
        if disconnect_error is not None:
            self.arduino_status.set(
                f"Disconnect safety command failed: {disconnect_error}"
            )
        else:
            self.arduino_status.set("Arduino disconnected")

    def _stop_running(self) -> None:
        self.running = False
        self.run_button_text.set("Resume")
        if self.arduino_serial is not None:
            self._write_actuator_command(0.0, 0.0, 0.0)

    def _close_window(self) -> None:
        self._stop_running()
        self._disconnect_arduino()
        if self.after_job is not None:
            self.root.after_cancel(self.after_job)
        self.root.destroy()

    def _load_feedforward_table(self) -> None:
        """Load a steady-state scan CSV and invert it for the feedforward mode."""

        selected = filedialog.askopenfilename(
            title="Steady-state susceptibility CSV",
            filetypes=[("CSV files", "*.csv"), ("All files", "*.*")],
        )
        if not selected:
            return
        try:
            table, column = load_feedforward_table(Path(selected))
        except (OSError, ValueError) as error:
            messagebox.showerror("Cannot use that table", str(error))
            return
        self.feedforward_table = table
        self.feedforward_status.set(
            f"{Path(selected).name} [{column}]: {len(table)} points"
        )
        if self.controller_mode.get() == "raw_offset_sine":
            table_config = replace(self.config, feedforward_table=table)
            self.diagnostic_ua_pwm.set(
                f"{feedforward_command(40.0, table_config):.2f}"
            )
        self._on_parameter_edit()

    def _clear_feedforward_table(self) -> None:
        self.feedforward_table = None
        self.feedforward_status.set("model line (chi_c, chi_h)")
        self._on_parameter_edit()

    def _change_parameter_source(self, _event=None) -> None:
        """Switch between measured inputs and independently entered constants."""

        self._on_parameter_edit()

    def _zero_integral(self) -> None:
        """Clear controller memory without resetting time or temperature."""

        self.state.integral_error_c_s = 0.0
        self.arduino_integral_error_c_s = 0.0
        self.latest = self._current_result()
        self._draw()

    def _on_parameter_edit(self, *_trace_arguments: str) -> None:
        """Apply valid slider and entry changes without restarting the model."""

        if self.syncing_derived_fields:
            return
        try:
            self.config = self._read_config()
        except (ValueError, tk.TclError):
            return
        if hasattr(self, "state"):
            self.latest = self._current_result()
            self._draw()

    def _apply_parameter_edit(self, _event=None) -> str:
        try:
            self.config = self._read_config()
        except ValueError as error:
            messagebox.showerror("Check the model parameters", str(error))
            return "break"
        self.latest = self._current_result()
        self._draw()
        return "break"

    def _toggle_running(self) -> None:
        if self.running:
            self._stop_running()
        else:
            try:
                self.config = self._read_config()
            except ValueError as error:
                messagebox.showerror("Check the model parameters", str(error))
                return
            mode = self.controller_mode.get()
            if (
                self.run_mode.get() == "Arduino hardware"
                and self.arduino_serial is None
            ):
                messagebox.showerror(
                    "Connect to the Arduino",
                    "Connect to the Arduino before starting hardware control.",
                )
                return
            if self.run_mode.get() == "Arduino hardware":
                try:
                    validate_diagnostic_parameters(
                        mode,
                        self.diagnostic_ua_pwm.get(),
                        self.diagnostic_ub_pwm.get(),
                        self.diagnostic_omega_rad_s.get(),
                    )
                except ValueError as error:
                    messagebox.showerror("Invalid diagnostic PWM", str(error))
                    return
            if (
                self.run_mode.get() == "Arduino hardware"
                and mode not in {"raw_sine", "raw_offset_sine"}
                and (not self.schedule_accepted or self.schedule_upload_pending)
            ):
                messagebox.showerror(
                    "Send a valid schedule",
                    "Edit and send a schedule, then wait for Arduino validation.",
                )
                return
            self.running = True
            self.run_button_text.set("Pause")
            if self.run_mode.get() == "Arduino hardware":
                self._write_actuator_command(0.0, 0.0, 0.0)
        self._draw()

    def _schedule_next_tick(self) -> None:
        self.after_job = self.root.after(UPDATE_INTERVAL_MS, self._tick)

    def _tick(self) -> None:
        if self.arduino_serial is not None:
            self._poll_arduino()
            last_received = self.arduino_last_record_received_at
            if (
                last_received is not None
                and not self.arduino_missing_record_reported
                and time.monotonic() - last_received
                >= ARDUINO_MISSING_RECORD_TIMEOUT_S
            ):
                self.arduino_missing_record_reported = True
                self.arduino_status.set(
                    "Missing Arduino DATA records: no valid record for "
                    f"{ARDUINO_MISSING_RECORD_TIMEOUT_S:g} seconds."
                )
        if self.run_mode.get() != "Arduino hardware" and self.running:
            simulated_interval = (
                self.config.simulation_speed * UPDATE_INTERVAL_MS / 1000.0
            )
            steps = max(1, round(simulated_interval / self.config.dt_s))
            for _ in range(steps):
                self.latest = advance_model(
                    self.state,
                    self.config,
                    self.process_mode.get(),
                    self.controller_mode.get(),
                )
                self._record(self.latest)
            self._trim_history()
            self._draw()
        self._schedule_next_tick()

    def _poll_arduino(self) -> None:
        connection = self.arduino_serial
        if connection is None:
            return
        try:
            available = connection.in_waiting
            if available:
                self.arduino_rx_buffer.extend(connection.read(available))
            while b"\n" in self.arduino_rx_buffer:
                raw_line, _, remainder = self.arduino_rx_buffer.partition(b"\n")
                self.arduino_rx_buffer = bytearray(remainder)
                line = raw_line.decode("ascii", errors="replace").strip()
                if line.startswith("SCHEDULE_ACK,"):
                    self._handle_schedule_ack(line)
                    continue
                try:
                    telemetry = parse_arduino_data_line(line)
                except ValueError as error:
                    self.arduino_status.set(
                        f"Ignored malformed Arduino DATA row: {error}"
                    )
                    continue
                if telemetry is not None:
                    now = time.monotonic()
                    self.arduino_last_record_received_at = now
                    self.arduino_missing_record_reported = False
                    self.arduino_data_warning = ""
                    if self.arduino_last_time_s is not None:
                        gap_ms = telemetry.elapsed_ms - self.arduino_last_time_s * 1000.0
                        expected_ms = ARDUINO_REPORT_INTERVAL_S * 1000.0
                        if gap_ms > expected_ms * 1.5:
                            missing = max(1, round(gap_ms / expected_ms) - 1)
                            self.arduino_data_warning = (
                                f"Missing {missing} DATA record(s) before this row."
                            )
                    self._handle_arduino_telemetry(telemetry)
        except (serial.SerialException, OSError) as error:
            self._handle_arduino_error(error)

    def _handle_schedule_ack(self, line: str) -> None:
        fields = line.split(",")
        if len(fields) == 3 and fields[1] == "OK":
            self.schedule_accepted = True
            self.schedule_upload_pending = False
            self.running = False
            self.run_button_text.set("Resume")
            self.arduino_status.set(
                f"Arduino accepted the {fields[2]}-step schedule; connection retained"
            )
            self.schedule_step_status.set(
                f"Schedule validated ({fields[2]} steps); press Resume to run"
            )
        elif len(fields) == 3 and fields[1] == "ERROR":
            self.schedule_upload_pending = False
            self.arduino_status.set(f"Arduino rejected schedule: {fields[2]}")
            self.schedule_step_status.set(
                "Schedule rejected; previous schedule retained"
                if self.schedule_accepted
                else "Schedule rejected; upload a valid schedule"
            )
        else:
            self.arduino_status.set(f"Ignored malformed schedule response: {line}")

    def _write_actuator_command(
        self, command: float, raw_command: float, feedforward_pwm: float
    ) -> None:
        connection = self.arduino_serial
        if connection is None:
            return
        operating_state = "RUNNING" if self.running else "PAUSED"
        mode = self.controller_mode.get()
        try:
            diagnostic_parameters = validate_diagnostic_parameters(
                mode,
                self.diagnostic_ua_pwm.get(),
                self.diagnostic_ub_pwm.get(),
                self.diagnostic_omega_rad_s.get(),
            )
        except ValueError as error:
            self.running = False
            self.run_button_text.set("Resume")
            self.arduino_status.set(f"Invalid diagnostic PWM; output paused: {error}")
            operating_state = "PAUSED"
            mode = "pi"
            diagnostic_parameters = (0.0, 0.0, 0.0)
            command = raw_command = feedforward_pwm = 0.0
        signed_pwm = (
            int(round(command))
            if self.running and mode not in {"raw_sine", "raw_offset_sine"}
            else 0
        )
        diagnostic_ua, diagnostic_ub, diagnostic_omega = diagnostic_parameters
        payload = (
            f"ACTUATOR,{operating_state},{mode},"
            f"{feedforward_pwm:.4f},{raw_command:.4f},"
            f"{measured_cooling_compensation_ratio(self.config):.4f},"
            f"{signed_pwm},"
            f"{diagnostic_ua:.4f},{diagnostic_ub:.4f},"
            f"{diagnostic_omega:.6f}\n"
        )
        try:
            connection.write(payload.encode("ascii"))
        except (serial.SerialException, OSError) as error:
            self._handle_arduino_error(error)

    def _handle_arduino_error(self, error: Exception) -> None:
        self.running = False
        self.run_button_text.set("Resume")
        self._disconnect_arduino()
        self.arduino_status.set(f"Arduino communication error: {error}")
        messagebox.showerror("Arduino communication error", str(error))

    def _handle_arduino_telemetry(self, telemetry: ArduinoTelemetry) -> None:
        if self.run_mode.get() != "Arduino hardware":
            return
        time_s = telemetry.elapsed_ms / 1000.0
        if self.arduino_last_time_s is not None:
            elapsed_s = time_s - self.arduino_last_time_s
            if elapsed_s <= 0.0:
                self.arduino_status.set(
                    "Ignored duplicate or out-of-order DATA row"
                )
                return
        else:
            elapsed_s = ARDUINO_REPORT_INTERVAL_S
        self.arduino_last_time_s = time_s
        self.state.time_s = time_s
        self.state.tec_temperature_c = telemetry.tec_c
        self.state.measured_temperature_c = telemetry.tec_c
        self.state.integral_error_c_s = self.arduino_integral_error_c_s
        self._update_schedule_display(telemetry)
        if telemetry.operating_state == "COMPLETE":
            self.running = False
            self.schedule_accepted = False
            self.run_button_text.set("Resume")
            self.schedule_step_status.set(
                f"Schedule complete at step {telemetry.schedule_step + 1}; "
                "send a schedule to run again"
            )

        hardware_config = replace(
            self.config, setpoint_c=telemetry.setpoint_c, dt_s=elapsed_s
        )
        controller_mode = self.controller_mode.get()
        if controller_mode in {"raw_sine", "raw_offset_sine"}:
            error = telemetry.setpoint_c - telemetry.tec_c
            p_term = i_term = 0.0
            raw_command = telemetry.raw_controller_pwm
            command = float(telemetry.applied_signed_pwm)
            saturated = not math.isclose(raw_command, command)
            feedforward_pwm = (
                feedforward_command(40.0, hardware_config)
                if controller_mode == "raw_offset_sine"
                else 0.0
            )
        else:
            feedforward_pwm = feedforward_command(
                telemetry.setpoint_c, hardware_config
            )
            (
                error,
                p_term,
                i_term,
                raw_command,
                command,
                saturated,
            ) = corrected_hardware_command(
                self.state,
                hardware_config,
                telemetry.setpoint_c,
                controller_mode,
                elapsed_s,
                feedforward_pwm,
                advance_integral=self.running
                and telemetry.operating_state not in {
                    "SHUTDOWN", "COMPLETE", "READY"
                },
            )
            self.arduino_integral_error_c_s = self.state.integral_error_c_s
            if telemetry.operating_state in {"SHUTDOWN", "COMPLETE", "READY"}:
                command = 0.0
            if telemetry.operating_state == "COMPLETE":
                self._write_actuator_command(0.0, 0.0, 0.0)
            else:
                self._write_actuator_command(
                    command if telemetry.operating_state != "SHUTDOWN" else 0.0,
                    raw_command,
                    feedforward_pwm,
                )
        if controller_mode in {"raw_sine", "raw_offset_sine"}:
            self._write_actuator_command(
                0.0, 0.0,
                feedforward_command(40.0, hardware_config)
                if controller_mode == "raw_offset_sine"
                else 0.0,
            )
        applied_command = (
            telemetry.applied_signed_pwm
            if telemetry.operating_state == "RUNNING"
            else 0
        )
        self.latest = StepResult(
            time_s,
            telemetry.tec_c,
            telemetry.tec_c,
            error,
            p_term,
            i_term,
            applied_command,
            saturated,
        )
        self.times.append(time_s)
        self.hardware_setpoints.append(telemetry.setpoint_c)
        self.tec_temperatures.append(telemetry.tec_c)
        self.measured_temperatures.append(telemetry.tec_c)
        for rod_values, temperature in zip(
            self.rod_temperatures, telemetry.rod_temperatures_c
        ):
            rod_values.append(temperature)
        self.p_terms.append(p_term)
        self.i_terms.append(i_term)
        self.commands.append(applied_command)
        self.errors.append(error)
        self._trim_history()
        self._draw()
        self.hardware_live_status.set(
            f"{telemetry.control_mode} | setpoint {telemetry.setpoint_c:.2f} °C | "
            f"raw {telemetry.raw_controller_pwm:.2f} PWM | "
            f"applied {telemetry.applied_signed_pwm:+d} PWM"
        )
        status = (
            f"Safety shutdown reported by Arduino at {telemetry.tec_c:.2f} °C"
            if telemetry.operating_state == "SHUTDOWN"
            else (
                "Arduino schedule complete; TEC output is off"
                if telemetry.operating_state == "COMPLETE"
                else f"Arduino {telemetry.operating_state.lower()} at {time_s:.2f} s"
            )
        )
        if self.arduino_data_warning:
            status = f"{status}. {self.arduino_data_warning}"
        self.arduino_status.set(status)

    def _record(self, result: StepResult) -> None:
        self.times.append(result.time_s)
        self.tec_temperatures.append(result.tec_temperature_c)
        self.measured_temperatures.append(result.measured_temperature_c)
        self.p_terms.append(result.p_pwm)
        self.i_terms.append(result.i_pwm)
        self.commands.append(result.applied_pwm)
        self.errors.append(result.error_c)

    def _trim_history(self) -> None:
        earliest = self.state.time_s - 1.2 * self.config.window_s
        first = 0
        while first < len(self.times) - 1 and self.times[first] < earliest:
            first += 1
        if first:
            self.times = self.times[first:]
            self.tec_temperatures = self.tec_temperatures[first:]
            self.measured_temperatures = self.measured_temperatures[first:]
            self.p_terms = self.p_terms[first:]
            self.i_terms = self.i_terms[first:]
            self.commands = self.commands[first:]
            self.errors = self.errors[first:]
            self.hardware_setpoints = self.hardware_setpoints[first:]
            self.rod_temperatures = [
                values[first:] for values in self.rod_temperatures
            ]

    def _draw(self) -> None:
        self._update_field_states()
        for axis in (self.ax_temperature, self.ax_command, self.ax_error):
            axis.clear()
            axis.grid(True, alpha=0.25)

        process = self.process_mode.get()
        controller = self.controller_mode.get()
        target_temperature = controller_target_temperature(self.config, controller)
        target_label = r"$T_{ss}$" if controller == "open_loop" else r"$T_{set}$"
        if self.run_mode.get() == "Arduino hardware":
            temperature_labels = arduino_temperature_legend_labels(
                self.tec_temperatures[-1], self.rod_temperatures
            )
            self.ax_temperature.plot(
                self.times,
                self.tec_temperatures,
                color="tab:blue",
                linewidth=2,
                label=temperature_labels[0],
            )
            for index, temperatures in enumerate(self.rod_temperatures, start=1):
                self.ax_temperature.plot(
                    self.times,
                    temperatures,
                    linewidth=1,
                    label=temperature_labels[index],
                )
        elif process == "one_lump":
            self.ax_temperature.plot(
                self.times,
                self.tec_temperatures,
                color="tab:blue",
                linewidth=2,
                label=r"$T$",
            )
        else:
            if not self.mass_temperature_only.get():
                self.ax_temperature.plot(
                    self.times,
                    self.tec_temperatures,
                    color="tab:red",
                    linewidth=1.8,
                    label=r"TEC-side $T$",
                )
            self.ax_temperature.plot(
                self.times,
                self.measured_temperatures,
                color="tab:blue",
                linewidth=2,
                label=r"measured $T_m$",
            )
        if self.run_mode.get() == "Arduino hardware":
            self.ax_temperature.plot(
                self.times,
                self.hardware_setpoints,
                color="black",
                linestyle="--",
                linewidth=1,
                label="scheduled setpoint",
            )
        else:
            self.ax_temperature.axhline(
                target_temperature,
                color="black",
                linestyle="--",
                linewidth=1,
                label=target_label,
            )
        self.ax_temperature.set_ylabel(r"Temperature ($^\circ$C)")
        self.ax_temperature.legend(
            loc="center left",
            bbox_to_anchor=(1.01, 0.5),
            fontsize=14.0,
            handlelength=2.2,
            borderaxespad=0.25,
        )

        self.ax_command.plot(
            self.times, self.p_terms, color="tab:blue", label=r"$u_P$"
        )
        self.ax_command.plot(
            self.times, self.i_terms, color="tab:orange", label=r"$u_I$"
        )
        self.ax_command.plot(
            self.times, self.commands, color="black", linewidth=2, label=r"applied $u$"
        )
        self.ax_command.axhline(0.0, color="gray", linewidth=0.8)
        self.ax_command.set_ylabel("Signed PWM")
        self.ax_command.legend(
            loc="center left",
            bbox_to_anchor=(1.01, 0.5),
            fontsize=14.0,
            handlelength=2.2,
            borderaxespad=0.25,
        )

        self.ax_error.plot(
            self.times,
            self.errors,
            color="tab:green",
            linewidth=2,
            label=(
                r"$e=T_{ss}-T_{measured}$"
                if controller == "open_loop"
                else r"$e=T_{set}-T_{measured}$"
            ),
        )
        self.ax_error.axhline(0.0, color="gray", linewidth=0.8)
        self.ax_error.set_ylabel(r"Error ($^\circ$C)")
        self.ax_error.set_xlabel("Model time (s)")
        self.ax_error.legend(
            loc="center left",
            bbox_to_anchor=(1.01, 0.5),
            fontsize=14.0,
            handlelength=2.2,
            borderaxespad=0.25,
        )

        left = max(0.0, self.state.time_s - self.config.window_s)
        right = max(self.config.window_s, self.state.time_s)
        self.ax_error.set_xlim(left, right)

        visible_temperatures = [
            value
            for time_s, value in zip(self.times, self.measured_temperatures)
            if time_s >= left
        ]
        if process == "one_lump" or not self.mass_temperature_only.get():
            visible_temperatures.extend(
                value
                for time_s, value in zip(self.times, self.tec_temperatures)
                if time_s >= left
            )
        visible_temperatures.extend((self.config.ambient_c, target_temperature))
        if self.run_mode.get() == "Arduino hardware":
            visible_temperatures.extend(
                setpoint
                for time_s, setpoint in zip(self.times, self.hardware_setpoints)
                if time_s >= left
            )
            visible_temperatures.extend(
                temperature
                for values in self.rod_temperatures
                for time_s, temperature in zip(self.times, values)
                if time_s >= left and math.isfinite(temperature)
            )
        low_t = min(visible_temperatures)
        high_t = max(visible_temperatures)
        margin_t = max(1.0, 0.1 * (high_t - low_t))
        self.ax_temperature.set_ylim(low_t - margin_t, high_t + margin_t)

        visible_commands = [0.0]
        for time_s, p_term, i_term, command in zip(
            self.times, self.p_terms, self.i_terms, self.commands
        ):
            if time_s >= left:
                visible_commands.extend((p_term, i_term, command))
        low_u = min(visible_commands)
        high_u = max(visible_commands)
        margin_u = max(1.0, 0.08 * (high_u - low_u))
        self.ax_command.set_ylim(low_u - margin_u, high_u + margin_u)

        visible_errors = [
            value
            for time_s, value in zip(self.times, self.errors)
            if time_s >= left
        ] + [0.0]
        low_e = min(visible_errors)
        high_e = max(visible_errors)
        margin_e = max(0.25, 0.10 * (high_e - low_e))
        self.ax_error.set_ylim(low_e - margin_e, high_e + margin_e)

        cooling_chi = cooling_susceptibility(self.config)
        heating_chi = heating_susceptibility(self.config)
        susceptibility = (
            active_tec_coefficient(self.config, self.config.open_loop_pwm)
            / self.config.heat_loss_w_per_c
            if controller == "open_loop"
            else open_loop_susceptibility(self.config)
        )
        if controller == "open_loop":
            thermal_input = r"P_u(u)u_{user}"
            controller_lines = (
                rf"$u=u_{{user}}={self.config.open_loop_pwm:.3g}\,\mathrm{{PWM}}$",
            )
        elif controller == "feedforward":
            thermal_input = r"P_u(u)u_{ff}"
            controller_lines = (
                r"$e=T_{set}-T_{meas}$",
                r"$u=u_{ff}(T_{set})$",
            )
        elif controller == "p":
            thermal_input = r"P_u(u)K_p e"
            controller_lines = (
                r"$e=T_{set}-T_{meas}$",
                r"$u=K_p e$",
            )
        else:
            thermal_input = r"P_u(u)\left(K_p e+K_i\int e\,dt\right)"
            controller_lines = (
                r"$e=T_{set}-T_{meas}$",
                r"$u=K_p e+K_i\int e\,dt$",
            )

        if process == "one_lump":
            self.left_equations.set_text(
                r"$\bf{Thermal\ model}$"
                "\n"
                r"$C=C_T+C_m$"
                "\n"
                rf"$C\frac{{dT}}{{dt}}={thermal_input}-H(T-T_{{amb}})$"
                "\n"
                rf"$\chi_c=\frac{{P_{{u,c}}}}{{H}}={cooling_chi:.3g},\quad"
                rf"\chi_h=\frac{{P_{{u,h}}}}{{H}}={heating_chi:.3g}\,^\circ\mathrm{{C/PWM}}$"
                "\n"
                rf"$r=\frac{{\chi_h}}{{\chi_c}}=\frac{{P_{{u,h}}}}{{P_{{u,c}}}}="
                rf"{self.config.heating_to_cooling_ratio:.3g}$"
                "\n"
                rf"$\tau=C/H={one_lump_time_constant(self.config):.3g}\,\mathrm{{s}}$"
            )
        else:
            tau_fast, tau_slow = two_lump_time_constants(self.config)
            self.left_equations.set_text(
                r"$\bf{Thermal\ model}$"
                "\n"
                rf"$C_T\frac{{dT}}{{dt}}={thermal_input}-G(T-T_m)$"
                "\n"
                r"$C_m\frac{dT_m}{dt}=G(T-T_m)-H(T_m-T_{amb})$"
                "\n"
                rf"$\chi_c={cooling_chi:.3g},\quad\chi_h={heating_chi:.3g}"
                r"\,^\circ\mathrm{C/PWM}$"
                "\n"
                rf"$r=\chi_h/\chi_c={self.config.heating_to_cooling_ratio:.3g}$"
                "\n"
                rf"$\tau_{{fast}}={tau_fast:.3g}\,\mathrm{{s}},\quad\tau_{{slow}}={tau_slow:.3g}\,\mathrm{{s}}$"
            )

        right_lines = [r"$\bf{Selected\ controller}$", "", "", *controller_lines]
        zeta: float | None = None
        if process == "one_lump" and controller == "pi":
            zeta = one_lump_pi_damping_ratio(self.config)
            zeta_text = r"\infty" if math.isinf(zeta) else f"{zeta:.3f}"
            right_lines.extend(
                (
                    r"One-lump PI:",
                    r"$\zeta_{1L,PI}=\frac{H+P_uK_p}"
                    r"{2\sqrt{CP_uK_i}}$"
                    rf"$={zeta_text}$ ({damping_description(zeta)})",
                )
            )
        elif process == "two_lump" and controller == "p":
            zeta = two_lump_p_damping_ratio(self.config)
            right_lines.extend(
                (
                    r"Two-lump P:",
                    r"$\zeta_{2L,P}=\frac{C_T(G+H)+C_mG}"
                    r"{2\sqrt{C_TC_mG(H+P_uK_p)}}$"
                    rf"$={zeta:.3f}$ ({damping_description(zeta)})",
                )
            )
        elif process == "two_lump" and controller == "open_loop":
            zeta = two_lump_p_damping_ratio(self.config, kp_pwm_per_c=0.0)
            right_lines.extend(
                (
                    r"Two-lump open loop:",
                    r"$\zeta_{2L,OL}=\frac{C_T(G+H)+C_mG}"
                    r"{2\sqrt{C_TC_mGH}}$"
                    rf"$={zeta:.3f}$ ({damping_description(zeta)})",
                )
            )
        elif process == "two_lump" and controller == "pi":
            critical_ki = two_lump_pi_critical_integral_gain(self.config)
            integral_ratio = self.config.ki_pwm_per_c_s / critical_ki
            if integral_ratio < 1.0 - 1e-3:
                stability = "stable"
            elif integral_ratio > 1.0 + 1e-3:
                stability = "unstable"
            else:
                stability = "marginal"
            right_lines.extend(
                (
                    r"Two-lump PI stability:",
                    r"$K_{i,crit}=\frac{[C_T(G+H)+C_mG](H+P_uK_p)}"
                    r"{C_TC_mP_u}$",
                    rf"$K_i/K_{{i,crit}}={integral_ratio:.3f}$ ({stability})",
                )
            )
        self.right_equations.set_text("\n".join(right_lines))

        current_measured = measured_temperature(self.state, process)
        if process == "one_lump":
            self._set_live_symbol("temperature", r"T")
            self._set_live_symbol("time_scale", r"\tau_{\mathrm{OL}},\ \tau_P")
            self.live_temperature.set(f"= {self.state.tec_temperature_c:7.2f} °C")
            self.live_time_scale.set(
                f"= {one_lump_time_constant(self.config):.2f}; "
                f"{predicted_p_time_constant(self.config):.2f} s"
            )
        else:
            tau_fast, tau_slow = two_lump_time_constants(self.config)
            self._set_live_symbol("temperature", r"T,\ T_m")
            self._set_live_symbol(
                "time_scale", r"\tau_{\mathrm{fast}},\ \tau_{\mathrm{slow}}"
            )
            self.live_temperature.set(
                f"= {self.state.tec_temperature_c:7.2f}; "
                f"{current_measured:7.2f} °C"
            )
            self.live_time_scale.set(
                f"= {tau_fast:7.2f}; {tau_slow:7.2f} s"
            )
        self.live_error.set(f"= {self.latest.error_c:8.2f} °C")
        self.live_p.set(f"= {self.latest.p_pwm:8.2f} PWM")
        self.live_i.set(f"= {self.latest.i_pwm:8.2f} PWM")
        saturation = " (saturated)" if self.latest.saturated else ""
        self.live_command.set(
            f"= {self.latest.applied_pwm:8.2f} PWM{saturation}"
        )
        self.live_susceptibility.set(
            f"= {cooling_chi:.2f}; {heating_chi:.2f} °C/PWM"
        )
        delta_t = target_temperature - self.config.ambient_c
        if susceptibility > 0.0:
            required_command = delta_t / susceptibility
            self.live_required_command.set(
                f"= ΔT/χ = {required_command:7.2f} PWM"
            )
        else:
            self.live_required_command.set("= ΔT/χ = undefined")
        required_power = self.config.heat_loss_w_per_c * delta_t
        self.live_required_power.set(f"= HΔT = {required_power:7.2f} W")
        self.live_p_prediction.set(
            f"= {predicted_p_droop(self.config):7.2f} °C"
        )
        if zeta is None:
            self.live_damping.set("")
            self.live_value_frames["damping"].grid_remove()
        else:
            self.live_value_frames["damping"].grid()
            zeta_display = "∞" if math.isinf(zeta) else f"{zeta:.2f}"
            self.live_damping.set(
                f"= {zeta_display} ({damping_description(zeta)})"
            )
        run_state = "Running" if self.running else "Paused"
        self.live_status.set(
            f"{run_state} | {process.replace('_', ' ')} | "
            f"{controller.replace('_', ' ')} | {self.run_mode.get()} | "
            f"{self.parameter_source.get()}"
        )
        self.canvas.draw_idle()

    def _update_field_states(self) -> None:
        """Disable sliders that do not affect the selected model or controller."""

        process = self.process_mode.get()
        controller = self.controller_mode.get()
        self.process_mode_box.configure(
            state="disabled" if self.run_mode.get() == "Arduino hardware" else "readonly"
        )
        measured_parameters = self.parameter_source.get() == "measured"
        enabled = {
            attribute: True for attribute in self.field_widgets
        }
        enabled["coupling_w_per_c"] = process == "two_lump"
        for attribute in (
            "measured_cooling_chi_c_per_pwm",
            "measured_heating_chi_c_per_pwm",
            "measured_tau_s",
            "tec_voltage_v",
            "tec_resistance_ohm",
        ):
            enabled[attribute] = measured_parameters
        for attribute in (
            "total_capacitance_j_per_c",
            "heat_loss_w_per_c",
            "tec_power_w_per_pwm",
            "heating_to_cooling_ratio",
        ):
            enabled[attribute] = not measured_parameters
        enabled["open_loop_pwm"] = controller == "open_loop"
        enabled["setpoint_c"] = controller != "open_loop"
        enabled["kp_pwm_per_c"] = controller in {"p", "pi"}
        enabled["ki_pwm_per_c_s"] = controller == "pi"

        ki_slider = self.field_widgets["ki_pwm_per_c_s"][2]
        ki_upper = max(5.0, self.entries["ki_pwm_per_c_s"].get())
        if process == "two_lump" and controller == "pi":
            critical_ki = two_lump_pi_critical_integral_gain(self.config)
            ki_upper = max(ki_upper, math.ceil(1.25 * critical_ki))
        ki_slider.configure(to=ki_upper)

        self.mass_only_button.configure(
            state="normal" if process == "two_lump" else "disabled"
        )
        for attribute, widgets in self.field_widgets.items():
            state = "normal" if enabled[attribute] else "disabled"
            for widget in widgets:
                try:
                    if str(widget.cget("state")) != state:
                        widget.configure(state=state)
                except tk.TclError:
                    pass


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Module 6 TEC simulation and Module 7 Arduino controller"
    )
    parser.add_argument(
        "--demo", action="store_true", help="save a non-interactive two-lump PI plot"
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=Path("python/Lab_6_7_modeling_tec_demo.png"),
        help="output path used with --demo",
    )
    parser.add_argument(
        "--hardware",
        action="store_true",
        help="start the GUI in Arduino hardware mode, paused at zero PWM",
    )
    parser.add_argument(
        "--port",
        help="serial port to connect on startup (requires --hardware), e.g. COM3",
    )
    parser.add_argument(
        "--start",
        action="store_true",
        help="start PI hardware control immediately (requires --hardware and --port)",
    )
    args = parser.parse_args()
    if args.demo:
        run_demo(args.output)
        return
    if args.port and not args.hardware:
        parser.error("--port requires --hardware")
    if args.hardware and not args.port:
        parser.error("--hardware requires --port")
    if args.start and not args.hardware:
        parser.error("--start requires --hardware and --port")

    root = tk.Tk()
    ModelingTECGui(
        root,
        hardware_port=args.port,
        start_hardware=args.start,
    )
    root.mainloop()


if __name__ == "__main__":
    main()