@dataclass(frozen=True)
class ScheduleStep:
    """One finite-duration temperature sinusoid in the hardware schedule."""

    duration_s: float
    mean_c: float
    amplitude_c: float
    period_s: float


def validate_schedule(steps: list[ScheduleStep]) -> None:
    """Validate schedule bounds shared by the GUI and Arduino."""

    if not 1 <= len(steps) <= MAX_SCHEDULE_STEPS:
        raise ValueError(f"Schedule must contain 1 to {MAX_SCHEDULE_STEPS} steps.")
    total_duration_ms = 0
    for index, step in enumerate(steps, start=1):
        values = (
            step.duration_s,
            step.mean_c,
            step.amplitude_c,
            step.period_s,
        )
        if not all(math.isfinite(value) for value in values):
            raise ValueError(f"Step {index} contains a non-finite value.")
        if not 0.1 <= step.duration_s <= MAX_STEP_DURATION_S:
            raise ValueError(f"Step {index} duration must be 0.1 to 86400 seconds.")
        if not 0.0 <= step.amplitude_c <= 30.0:
            raise ValueError(f"Step {index} amplitude must be 0 to 30 °C.")
        if not 0.1 <= step.period_s <= MAX_STEP_DURATION_S:
            raise ValueError(f"Step {index} period must be 0.1 to 86400 seconds.")
        if not -10.0 <= step.mean_c - step.amplitude_c:
            raise ValueError(f"Step {index} sinusoid falls below -10 °C.")
        if step.mean_c + step.amplitude_c > 60.0:
            raise ValueError(f"Step {index} sinusoid exceeds 60 °C.")
        duration_ms = round(step.duration_s * 1000.0)
        if duration_ms < 100:
            raise ValueError(f"Step {index} duration must be at least 0.1 seconds.")
        total_duration_ms += duration_ms
        if total_duration_ms > MAX_SCHEDULE_DURATION_MS:
            raise ValueError("Total schedule duration exceeds the Arduino timer range.")


def serialize_schedule(steps: list[ScheduleStep]) -> str:
    """Encode the validated schedule in the Arduino SCHEDULE wire format."""

    validate_schedule(steps)
    fields = ["SCHEDULE", str(len(steps))]
    for step in steps:
        fields.extend(
            (
                str(round(step.duration_s * 1000.0)),
                f"{step.mean_c:.6g}",
                f"{step.amplitude_c:.6g}",
                f"{step.period_s:.6g}",
            )
        )
    return ",".join(fields)


def parse_arduino_data_line(line: str) -> ArduinoTelemetry | None:
    """Parse one documented DATA row; ignore headers and other serial messages."""

    line = line.strip()
    if line == ARDUINO_DATA_HEADER:
        return None
    fields = line.split(",")
    if not fields or fields[0] != "DATA":
        return None
    if len(fields) != 23:
        raise ValueError(f"Expected 23 DATA fields, received {len(fields)}.")

    try:
        numeric = [float(fields[index]) for index in (1, 4, *range(5, 23))]
    except ValueError as error:
        raise ValueError("DATA row contains a non-numeric field.") from error
    if not all(math.isfinite(value) for value in numeric):
        raise ValueError("DATA row contains a non-finite field.")
    (
        elapsed_ms, segment, duration_ms, mean_c, amplitude_c, period_s,
        setpoint_c, feedforward_pwm, tec_c, *remaining
    ) = numeric
    rods = tuple(remaining[:5])
    (
        raw_command, cooling_ratio, applied_pwm, diagnostic_ua,
        diagnostic_ub, diagnostic_omega,
    ) = remaining[5:]
    valid_modes = {
        "open_loop", "feedforward", "p", "pi", "raw_sine", "raw_offset_sine"
    }
    if (
        elapsed_ms < 0 or not elapsed_ms.is_integer()
        or segment < -1 or segment >= MAX_SCHEDULE_STEPS
        or not segment.is_integer()
        or duration_ms < 0 or not duration_ms.is_integer()
        or duration_ms > MAX_STEP_DURATION_S * 1000.0
        or amplitude_c < 0 or amplitude_c > 30
        or period_s < 0 or period_s > MAX_STEP_DURATION_S
        or not -10.0 <= setpoint_c <= 60.0
        or (segment >= 0 and (
            duration_ms <= 0 or period_s <= 0
            or mean_c - amplitude_c < -10.0 or mean_c + amplitude_c > 60.0
        ))
        or (segment == -1 and (
            duration_ms != 0 or mean_c != 0.0 or amplitude_c != 0.0
            or period_s != 0.0
        ))
        or cooling_ratio <= 0
        or not applied_pwm.is_integer() or not -255 <= applied_pwm <= 255
        or fields[2] not in {
            "RUNNING", "PAUSED", "READY", "COMPLETE", "SHUTDOWN"
        }
        or fields[3] not in valid_modes
    ):
        raise ValueError("DATA row contains an invalid state, mode, or range.")
    if fields[3] == "raw_sine" and not (
        diagnostic_ua == 0.0 and 0.0 < diagnostic_ub <= 255.0
        and 0.0 < diagnostic_omega <= MAX_DIAGNOSTIC_OMEGA_RAD_S
    ):
        raise ValueError(
            "Raw sine parameters require ua=0, ub>0, and 0<omega<=2π rad/s."
        )
    if fields[3] == "raw_sine" and abs(raw_command) > diagnostic_ub + 0.0001:
        raise ValueError("Raw sine command is outside its requested amplitude.")
    if fields[3] == "raw_offset_sine" and not (
        diagnostic_ua > diagnostic_ub > 0.0
        and diagnostic_ua + diagnostic_ub <= 255.0
        and 0.0 < diagnostic_omega <= MAX_DIAGNOSTIC_OMEGA_RAD_S
    ):
        raise ValueError(
            "Offset sine parameters require 255>=ua>ub>0 and 0<omega<=2π rad/s."
        )
    if fields[3] not in {"raw_sine", "raw_offset_sine"} and (
        diagnostic_ua != 0.0 or diagnostic_ub != 0.0 or diagnostic_omega != 0.0
    ):
        raise ValueError("Non-diagnostic modes must report zero raw sine parameters.")
    if fields[3] == "raw_offset_sine" and not (
        diagnostic_ua - diagnostic_ub - 0.0001
        <= raw_command
        <= diagnostic_ua + diagnostic_ub + 0.0001
    ):
        raise ValueError("Offset sine command is outside its requested range.")
    if fields[2] == "RUNNING" and fields[3] in {
        "raw_sine", "raw_offset_sine"
    }:
        expected_pwm = (
            math.floor(raw_command + 0.5)
            if raw_command >= 0.0
            else math.ceil(raw_command - 0.5)
        )
        if int(applied_pwm) != max(-255, min(255, expected_pwm)):
            raise ValueError("Applied raw PWM does not match the requested command.")
    elif fields[2] != "RUNNING" and applied_pwm != 0:
        raise ValueError("A non-running Arduino state must have zero applied PWM.")
    return ArduinoTelemetry(
        elapsed_ms=int(elapsed_ms),
        operating_state=fields[2],
        control_mode=fields[3],
        schedule_step=int(segment),
        step_duration_ms=int(duration_ms),
        step_mean_c=mean_c,
        step_amplitude_c=amplitude_c,
        step_period_s=period_s,
        setpoint_c=setpoint_c,
        feedforward_pwm=feedforward_pwm,
        tec_c=tec_c,
        rod_temperatures_c=rods,
        raw_controller_pwm=raw_command,
        cooling_ratio=cooling_ratio,
        applied_signed_pwm=int(applied_pwm),
        diagnostic_ua_pwm=diagnostic_ua,
        diagnostic_ub_pwm=diagnostic_ub,
        diagnostic_omega_rad_s=diagnostic_omega,
    )


def arduino_temperature_legend_labels(
    tec_c: float, rod_temperatures_c: list[list[float]]
) -> tuple[str, str, str, str, str, str]:
    """Build legend text for the latest T0-T5 Arduino readings."""

    temperatures = (tec_c,) + tuple(
        values[-1] if values else math.nan for values in rod_temperatures_c
    )
    return tuple(
        f"T{index} (A{index}): {temperature:.2f} C"
        if math.isfinite(temperature)
        else f"T{index} (A{index}): --"
        for index, temperature in enumerate(temperatures)
    )


def clamp(value: float, lower: float, upper: float) -> float:
    return max(lower, min(upper, value))


def measured_temperature(state: ModelState, process_mode: str) -> float:
    if process_mode == "one_lump":
        return state.tec_temperature_c
    if process_mode == "two_lump":
        return state.measured_temperature_c
    raise ValueError("process_mode must be 'one_lump' or 'two_lump'")


def load_feedforward_table(
    path: Path,
) -> tuple[tuple[tuple[float, float], ...], str]:
    """Read a steady-state scan CSV into (temperature_c, signed_pwm) points.

    Heating rows count as positive PWM and cooling rows as negative PWM.  The
    scan file's ``steady_T0`` column (the TEC base) is used when it exists;
    otherwise the file's single steady-temperature column is used.  Returns
    the points sorted by temperature and the name of the column used.
    """

    raw = path.read_bytes()
    try:
        text = raw.decode("utf-8-sig")
    except UnicodeDecodeError:
        text = raw.decode("cp1252")  # Windows Excel/Python files with a degree sign
    reader = csv.DictReader(io.StringIO(text))
    names = reader.fieldnames or []

    def pick(*candidates: str) -> str:
        for candidate in candidates:
            if candidate in names:
                return candidate
        raise ValueError(f"The CSV has no column named {' or '.join(candidates)}.")

    direction_column = pick("direction", "Direction")
    pwm_column = pick("actual_pwm", "PWM")
    temperature_column = pick(
        "steady_T0", "steady_temp_c", "Steady Temperature (°C)"
    )

    temperatures_by_pwm: dict[float, list[float]] = {}
    for row in reader:
        temperature_text = (row.get(temperature_column) or "").strip()
        if not temperature_text or temperature_text.lower() == "nan":
            continue
        direction = (row.get(direction_column) or "").strip().upper()
        if direction not in {"HEAT", "COOL"}:
            raise ValueError(f"Unrecognized direction {direction!r}; expected HEAT or COOL.")
        try:
            pwm = abs(float(row[pwm_column]))
            temperature = float(temperature_text)
        except (TypeError, ValueError) as error:
            raise ValueError("The table has a non-numeric PWM or temperature.") from error
        if not (math.isfinite(pwm) and math.isfinite(temperature)):
            raise ValueError("The table has a non-finite PWM or temperature.")
        signed_pwm = pwm if direction == "HEAT" else -pwm
        temperatures_by_pwm.setdefault(signed_pwm, []).append(temperature)

    points = sorted(
        (sum(values) / len(values), pwm) for pwm, values in temperatures_by_pwm.items()
    )
    if len(points) < 2:
        raise ValueError("The table needs at least two distinct PWM levels.")
    by_command = sorted(points, key=lambda point: point[1])
    for lower, upper in zip(by_command, by_command[1:]):
        if upper[0] <= lower[0]:
            raise ValueError(
                f"Steady temperature does not rise with PWM between {lower[1]:g} and "
                f"{upper[1]:g} PWM, so the curve cannot be inverted."
            )
    return tuple(by_command), temperature_column


def feedforward_command(setpoint_c: float, config: ModelConfig) -> float:
    """Return the signed PWM whose steady-state temperature equals the setpoint.

    With a measured table this is linear interpolation of the table read
    backwards (temperature in, PWM out).  A setpoint beyond the measured range
    returns the end value instead of extrapolating.  Without a table it uses
    the straight-line model u = (T_set - T_amb)/chi, with chi_h for heating
    and chi_c for cooling.
    """

    table = config.feedforward_table
    if table:
        if setpoint_c <= table[0][0]:
            command = table[0][1]
        elif setpoint_c >= table[-1][0]:
            command = table[-1][1]
        else:
            command = table[-1][1]
            for (t_low, u_low), (t_high, u_high) in zip(table, table[1:]):
                if t_low <= setpoint_c <= t_high:
                    command = u_low + (u_high - u_low) * (
                        (setpoint_c - t_low) / (t_high - t_low)
                    )
                    break
    else:
        delta_c = setpoint_c - config.ambient_c
        susceptibility = (
            heating_susceptibility(config)
            if delta_c >= 0.0
            else cooling_susceptibility(config)
        )
        command = delta_c / susceptibility if susceptibility > 0.0 else 0.0
    return clamp(command, -config.pwm_limit, config.pwm_limit)


def controller_command(
    state: ModelState,
    config: ModelConfig,
    process_mode: str,
    controller_mode: str,
    advance_integral: bool = True,
) -> tuple[float, float, float, float, bool]:
    """Return error, P term, I term, applied command, and saturation state."""

    error = controller_target_temperature(
        config, controller_mode
    ) - measured_temperature(state, process_mode)

    if controller_mode == "open_loop":
        raw_command = config.open_loop_pwm
        p_term = 0.0
        i_term = 0.0
    elif controller_mode == "feedforward":
        raw_command = feedforward_command(config.setpoint_c, config)
        state.integral_error_c_s = 0.0
        p_term = 0.0
        i_term = 0.0
    elif controller_mode in {"p", "pi"}:
        p_term = config.kp_pwm_per_c * error
        if controller_mode == "pi":
            if advance_integral:
                proposed_integral = state.integral_error_c_s + error * config.dt_s
                proposed_i = config.ki_pwm_per_c_s * proposed_integral
                proposed_command = p_term + proposed_i
                drives_farther_into_saturation = (
                    proposed_command > config.pwm_limit and error > 0.0
                ) or (
                    proposed_command < -config.pwm_limit and error < 0.0
                )
                if not (config.anti_windup and drives_farther_into_saturation):
                    state.integral_error_c_s = proposed_integral
            i_term = config.ki_pwm_per_c_s * state.integral_error_c_s
        else:
            state.integral_error_c_s = 0.0
            i_term = 0.0
        raw_command = p_term + i_term
    elif controller_mode in {"raw_sine", "raw_offset_sine"}:
        raw_command = 0.0
        p_term = 0.0
        i_term = 0.0
        state.integral_error_c_s = 0.0
    else:
        raise ValueError(
            "controller_mode must be 'open_loop', 'feedforward', 'p', or 'pi'"
        )

    applied = clamp(raw_command, -config.pwm_limit, config.pwm_limit)
    return error, p_term, i_term, applied, not math.isclose(raw_command, applied)


def corrected_hardware_command(
    state: ModelState,
    config: ModelConfig,
    setpoint_c: float,
    controller_mode: str,
    dt_s: float,
    feedforward_pwm: float,
    advance_integral: bool,
) -> tuple[float, float, float, float, float, bool]:
    """Compute a hardware command with signed cooling correction and saturation."""

    error = setpoint_c - state.tec_temperature_c
    ratio = measured_cooling_compensation_ratio(config)
    if controller_mode == "open_loop":
        raw_command = config.open_loop_pwm
        p_term = 0.0
        i_term = 0.0
        state.integral_error_c_s = 0.0
    elif controller_mode == "feedforward":
        raw_command = feedforward_pwm
        p_term = 0.0
        i_term = 0.0
        state.integral_error_c_s = 0.0
    elif controller_mode in {"p", "pi"}:
        p_term = config.kp_pwm_per_c * error
        if controller_mode == "pi":
            if advance_integral:
                proposed_integral = state.integral_error_c_s + error * dt_s
                proposed_raw = p_term + config.ki_pwm_per_c_s * proposed_integral
                proposed_corrected = (
                    proposed_raw * ratio if proposed_raw < 0.0 else proposed_raw
                )
                drives_farther_into_saturation = (
                    proposed_corrected > config.pwm_limit and error > 0.0
                ) or (
                    proposed_corrected < -config.pwm_limit and error < 0.0
                )
                if not (
                    config.anti_windup and drives_farther_into_saturation
                ):
                    state.integral_error_c_s = proposed_integral
            i_term = config.ki_pwm_per_c_s * state.integral_error_c_s
        else:
            state.integral_error_c_s = 0.0
            i_term = 0.0
        raw_command = p_term + i_term
    else:
        raise ValueError(
            "controller_mode must be 'open_loop', 'feedforward', 'p', or 'pi'"
        )

    corrected = (
        raw_command * ratio
        if controller_mode in {"p", "pi"} and raw_command < 0.0
        else raw_command
    )
    applied = clamp(corrected, -config.pwm_limit, config.pwm_limit)
    saturated = not math.isclose(corrected, applied)
    return error, p_term, i_term, raw_command, applied, saturated


def measured_cooling_compensation_ratio(config: ModelConfig) -> float:
    """Return the measured heating-to-cooling susceptibility ratio."""

    return (
        config.measured_heating_chi_c_per_pwm
        / config.measured_cooling_chi_c_per_pwm
    )


def validate_diagnostic_parameters(
    controller_mode: str, ua_text: str, ub_text: str, omega_text: str
) -> tuple[float, float, float]:
    """Validate raw-PWM sinusoid parameters and return the active mode values."""

    if controller_mode not in {"raw_sine", "raw_offset_sine"}:
        return 0.0, 0.0, 0.0
    try:
        ua = float(ua_text)
        ub = float(ub_text)
        omega = float(omega_text)
    except ValueError as error:
        raise ValueError("Raw PWM parameters must be numeric.") from error
    if not all(math.isfinite(value) for value in (ua, ub, omega)):
        raise ValueError("Raw PWM parameters must be finite.")
    ua = round(ua, 4)
    ub = round(ub, 4)
    omega = round(omega, 6)
    if not 0.0 < omega <= MAX_DIAGNOSTIC_OMEGA_RAD_S:
        raise ValueError(
            "Angular frequency must be greater than 0 and at most 2π rad/s."
        )
    if controller_mode == "raw_sine":
        if not 0.0 < ub <= 255.0:
            raise ValueError("Raw sine amplitude ub must be between 0 and 255 PWM.")
        return 0.0, ub, omega
    if not (ua > ub > 0.0 and ua + ub <= 255.0):
        raise ValueError(
            "Offset sine requires 255 >= ua + ub, with ua > ub > 0."
        )
    return ua, ub, omega


def advance_model(
    state: ModelState,
    config: ModelConfig,
    process_mode: str,
    controller_mode: str,
) -> StepResult:
    """Advance the selected dimensional thermal model by one Euler step."""

    error, p_term, i_term, command, saturated = controller_command(
        state, config, process_mode, controller_mode
    )
    tec_power_w = active_tec_coefficient(config, command) * command

    if process_mode == "one_lump":
        capacitance = config.one_lump_capacitance_j_per_c
        heat_loss_w = config.heat_loss_w_per_c * (
            state.tec_temperature_c - config.ambient_c
        )
        dtemperature_dt = (tec_power_w - heat_loss_w) / capacitance
        next_temperature = state.tec_temperature_c + config.dt_s * dtemperature_dt
        state.tec_temperature_c = next_temperature
        state.measured_temperature_c = next_temperature
    else:
        coupling_w = config.coupling_w_per_c * (
            state.tec_temperature_c - state.measured_temperature_c
        )
        measured_heat_loss_w = config.heat_loss_w_per_c * (
            state.measured_temperature_c - config.ambient_c
        )
        dtec_dt = (
            tec_power_w - coupling_w
        ) / config.tec_capacitance_j_per_c
        dmeasured_dt = (
            coupling_w - measured_heat_loss_w
        ) / config.measured_capacitance_j_per_c
        state.tec_temperature_c += config.dt_s * dtec_dt
        state.measured_temperature_c += config.dt_s * dmeasured_dt

    state.time_s += config.dt_s
    return StepResult(
        time_s=state.time_s,
        tec_temperature_c=state.tec_temperature_c,
        measured_temperature_c=state.measured_temperature_c,
        error_c=controller_target_temperature(
            config, controller_mode
        ) - measured_temperature(state, process_mode),
        p_pwm=p_term,
        i_pwm=i_term,
        applied_pwm=command,
        saturated=saturated,
    )


def cooling_tec_coefficient(config: ModelConfig) -> float:
    return config.tec_power_w_per_pwm


def heating_tec_coefficient(config: ModelConfig) -> float:
    return config.heating_to_cooling_ratio * cooling_tec_coefficient(config)


def active_tec_coefficient(config: ModelConfig, command: float) -> float:
    if command >= 0.0:
        return heating_tec_coefficient(config)
    return cooling_tec_coefficient(config)


def predicted_open_loop_steady_temperature(config: ModelConfig) -> float:
    """Return the measured steady temperature for the open-loop command."""

    return config.ambient_c + (
        active_tec_coefficient(config, config.open_loop_pwm)
        * config.open_loop_pwm
        / config.heat_loss_w_per_c
    )


def controller_target_temperature(config: ModelConfig, controller_mode: str) -> float:
    """Return the temperature reference used for display and error."""

    if controller_mode == "open_loop":
        return predicted_open_loop_steady_temperature(config)
    return config.setpoint_c


def cooling_susceptibility(config: ModelConfig) -> float:
    return cooling_tec_coefficient(config) / config.heat_loss_w_per_c


def heating_susceptibility(config: ModelConfig) -> float:
    return heating_tec_coefficient(config) / config.heat_loss_w_per_c


def open_loop_susceptibility(config: ModelConfig) -> float:
    """Return the susceptibility for the selected setpoint direction."""

    if config.setpoint_c >= config.ambient_c:
        return heating_susceptibility(config)
    return cooling_susceptibility(config)


def one_lump_time_constant(config: ModelConfig) -> float:
    return config.one_lump_capacitance_j_per_c / config.heat_loss_w_per_c


def two_lump_time_constants(config: ModelConfig) -> tuple[float, float]:
    """Return the fast and slow passive decay times of the two-lump model."""

    rate_sum = (
        config.coupling_w_per_c / config.tec_capacitance_j_per_c
        + (config.coupling_w_per_c + config.heat_loss_w_per_c)
        / config.measured_capacitance_j_per_c
    )
    rate_product = (
        config.coupling_w_per_c
        * config.heat_loss_w_per_c
        / (
            config.tec_capacitance_j_per_c
            * config.measured_capacitance_j_per_c
        )
    )
    discriminant = max(0.0, rate_sum**2 - 4.0 * rate_product)
    fast_rate = 0.5 * (rate_sum + math.sqrt(discriminant))
    slow_rate = 0.5 * (rate_sum - math.sqrt(discriminant))
    return 1.0 / fast_rate, 1.0 / slow_rate


def predicted_p_droop(config: ModelConfig) -> float:
    loop_gain = open_loop_susceptibility(config) * config.kp_pwm_per_c
    return (config.setpoint_c - config.ambient_c) / (1.0 + loop_gain)


def predicted_p_time_constant(config: ModelConfig) -> float:
    tec_coefficient = (
        heating_tec_coefficient(config)
        if config.setpoint_c >= config.ambient_c
        else cooling_tec_coefficient(config)
    )
    return config.one_lump_capacitance_j_per_c / (
        config.heat_loss_w_per_c + tec_coefficient * config.kp_pwm_per_c
    )


def one_lump_pi_damping_ratio(config: ModelConfig) -> float:
    tec_coefficient = (
        heating_tec_coefficient(config)
        if config.setpoint_c >= config.ambient_c
        else cooling_tec_coefficient(config)
    )
    denominator = 2.0 * math.sqrt(
        config.one_lump_capacitance_j_per_c
        * tec_coefficient
        * config.ki_pwm_per_c_s
    )
    if denominator == 0.0:
        return math.inf
    return (
        config.heat_loss_w_per_c
        + tec_coefficient * config.kp_pwm_per_c
    ) / denominator


def two_lump_p_damping_ratio(
    config: ModelConfig, kp_pwm_per_c: float | None = None
) -> float:
    """Return the two-lump damping ratio for open-loop or P dynamics."""

    tec_coefficient = (
        heating_tec_coefficient(config)
        if config.setpoint_c >= config.ambient_c
        else cooling_tec_coefficient(config)
    )
    c_tec = config.tec_capacitance_j_per_c
    c_mass = config.measured_capacitance_j_per_c
    coupling = config.coupling_w_per_c
    heat_loss = config.heat_loss_w_per_c
    kp = config.kp_pwm_per_c if kp_pwm_per_c is None else kp_pwm_per_c
    numerator = c_tec * (coupling + heat_loss) + c_mass * coupling
    denominator = 2.0 * math.sqrt(
        c_tec
        * c_mass
        * coupling
        * (heat_loss + tec_coefficient * kp)
    )
    return numerator / denominator


def two_lump_pi_critical_integral_gain(config: ModelConfig) -> float:
    """Return the Routh-Hurwitz stability boundary for two-lump PI control."""

    tec_coefficient = (
        heating_tec_coefficient(config)
        if config.setpoint_c >= config.ambient_c
        else cooling_tec_coefficient(config)
    )
    c_tec = config.tec_capacitance_j_per_c
    c_mass = config.measured_capacitance_j_per_c
    coupling = config.coupling_w_per_c
    heat_loss = config.heat_loss_w_per_c
    return (
        (c_tec * (coupling + heat_loss) + c_mass * coupling)
        * (heat_loss + tec_coefficient * config.kp_pwm_per_c)
        / (c_tec * c_mass * tec_coefficient)
    )


def damping_description(value: float) -> str:
    if math.isinf(value):
        return "no integral action"
    if value < 1.0 - 1e-9:
        return "underdamped"
    if value > 1.0 + 1e-9:
        return "overdamped"
    return "critically damped"


def validate_config(config: ModelConfig) -> None:
    positive = {
        "total capacitance C": config.total_capacitance_j_per_c,
        "coupling G": config.coupling_w_per_c,
        "heat-loss conductance H": config.heat_loss_w_per_c,
        "PWM limit": config.pwm_limit,
        "Euler time step": config.dt_s,
        "rolling window": config.window_s,
        "simulation speed": config.simulation_speed,
    }
    for label, value in positive.items():
        if value <= 0.0:
            raise ValueError(f"{label} must be positive.")
    if not 0.0 < config.tec_capacitance_fraction < 1.0:
        raise ValueError("The TEC capacitance fraction C_T/C must be between 0 and 1.")
    if config.tec_power_w_per_pwm < 0.0:
        raise ValueError("TEC coefficient P_u cannot be negative.")
    if config.heating_to_cooling_ratio <= 0.0:
        raise ValueError("Heating/cooling susceptibility ratio r must be positive.")
    if config.kp_pwm_per_c < 0.0 or config.ki_pwm_per_c_s < 0.0:
        raise ValueError("Kp and Ki must be zero or positive.")

    fastest_time = min(
        config.one_lump_capacitance_j_per_c / config.heat_loss_w_per_c,
        config.tec_capacitance_j_per_c / config.coupling_w_per_c,
        config.measured_capacitance_j_per_c
        / (config.coupling_w_per_c + config.heat_loss_w_per_c),
    )
    if config.dt_s > fastest_time / 5.0:
        raise ValueError("Use a time step no larger than one fifth of the fastest thermal time scale.")


def simulate(
    config: ModelConfig,
    process_mode: str,
    controller_mode: str,
    duration_s: float,
) -> list[StepResult]:
    """Return a complete simulation for tests and the non-interactive demo."""

    validate_config(config)
    state = ModelState(0.0, config.initial_c, config.initial_c)
    results: list[StepResult] = []
    while state.time_s < duration_s:
        results.append(advance_model(state, config, process_mode, controller_mode))
    return results


def run_demo(output: Path) -> None:
    """Save a reproducible two-lump PI demonstration plot."""

    os.environ.setdefault(
        "MPLCONFIGDIR", str(Path(tempfile.gettempdir()) / "phys39_matplotlib_cache")
    )
    import matplotlib

    matplotlib.use("Agg")
    import matplotlib.pyplot as plt

    config = ModelConfig()
    results = simulate(config, "two_lump", "pi", duration_s=600.0)
    times = [row.time_s for row in results]
    tec = [row.tec_temperature_c for row in results]
    measured = [row.measured_temperature_c for row in results]
    commands = [row.applied_pwm for row in results]
    errors = [row.error_c for row in results]

    figure, axes = plt.subplots(3, 1, figsize=(7, 9), sharex=True)
    axes[0].plot(times, tec, color="tab:red", label=r"TEC-side $T$")
    axes[0].plot(times, measured, color="tab:blue", label=r"measured $T_m$")
    axes[0].axhline(config.setpoint_c, color="black", linestyle="--", label="setpoint")
    axes[0].set_ylabel(r"temperature ($^\circ$C)")
    axes[0].legend(loc="best")
    axes[1].plot(times, commands, color="black")
    axes[1].axhline(0.0, color="gray", linewidth=0.8)
    axes[1].set_ylabel("signed PWM")
    axes[2].plot(times, errors, color="tab:green")
    axes[2].axhline(0.0, color="gray", linewidth=0.8)
    axes[2].set_ylabel(r"error ($^\circ$C)")
    axes[2].set_xlabel("time (s)")
    for axis in axes:
        axis.grid(True, alpha=0.25)

    figure.suptitle("Module 6 Part II: dimensional two-lump PI model")
    figure.tight_layout(rect=(0, 0, 1, 0.97))
    output.parent.mkdir(parents=True, exist_ok=True)
    figure.savefig(output, dpi=160)
    print(f"Saved demo plot: {output}")
    print(
        "Final state: "
        f"T={tec[-1]:.3f} C; T_m={measured[-1]:.3f} C; "
        f"error={errors[-1]:.3f} C; u={commands[-1]:.3f} PWM"
    )


