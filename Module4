# =============================================================================
# USER CONFIGURATION PARAMETERS
# =============================================================================
SERIAL_PORT = 'COM3'         # Serial port name
BAUD_RATE = 9600             # Baud rate
WINDOW_DURATION = 60.0       # Plot rolling window (seconds)
UPDATE_INTERVAL_MS = 50      # Loop check interval (ms)
TEMP_MIN = 15.0              # Min plot temp (°C)
TEMP_MAX = 45.0              # Max plot temp (°C)
CSV_FILENAME = 'temperature_control_log.csv'

LINE_PATTERN = re.compile(
    r"^Temperature \(C\):\s*([0-9\.-]+),\s*Time \(s\):\s*([0-9\.-]+),\s*PWM:\s*([0-9]+),\s*Heat/Cool:\s*([01])(?:,\s*Safety:.*)?$"
)

STEADY_PERCENTAGES = [0, 25, 50, 75, 100]
DIRECTIONS = ["HEAT", "COOL"]
STEADY_SLOPE_LIMIT_C_PER_S = 0.01
STABLE_WINDOW_SECONDS = 15.0
MIN_STEADY_SAMPLES = 8
MAX_STEADY_SECONDS = 60.0
CSV_STEADY_FILENAME = 'steady_state_temperature_scan.csv'
SUMMARY_FILENAME = 'steady_state_summary.csv'
AUTO_SWEEP_SECONDS = 30.0
AUTO_SWEEP_SEQUENCE = [
    ('HEAT', 0), ('COOL', 0),
    ('HEAT', 25), ('COOL', 25),
    ('HEAT', 50), ('COOL', 50),
    ('HEAT', 75), ('COOL', 75),
    ('HEAT', 100), ('COOL', 100),
]


def calculate_p_control(temp_c, setpoint_c, kp):
    error = setpoint_c - temp_c
    signed_pwm = kp * error
    direction = 'HEAT' if signed_pwm >= 0 else 'COOL'
    pwm = int(max(0, min(255, round(abs(signed_pwm)))))
    return error, direction, pwm


def wait_for_steady_state(ser, direction, target_percent):
    """Send a constant command and return the steady-state temperature for that setting."""
    requested_pwm = int(round((target_percent / 100.0) * 255))
    ser.write(f"SET PWM {requested_pwm} DIR {direction}\n".encode('utf-8'))
    print(f"Requested {direction} at {target_percent}% -> PWM {requested_pwm}")

    samples = []
    start_time = time.monotonic()
    last_log_time = start_time
    start_temp_c = None

    while time.monotonic() - start_time < MAX_STEADY_SECONDS:
        while ser.in_waiting > 0:
            try:
                line = ser.readline().decode('utf-8', errors='ignore').strip()
            except Exception:
                continue

            if not line:
                continue

            match = LINE_PATTERN.match(line)
            if not match:
                continue

            temp_c = float(match.group(1))
            time_s = float(match.group(2))
            actual_pwm = int(match.group(3))
            heat_cool = int(match.group(4))
            if start_temp_c is None:
                start_temp_c = temp_c

            samples.append({
                'time_s': time_s,
                'temp_c': temp_c,
                'actual_pwm': actual_pwm,
                'direction': 'HEAT' if heat_cool == 1 else 'COOL',
            })

        if time.monotonic() - last_log_time >= 2.0 and samples:
            latest = samples[-1]
            print(f"  t={latest['time_s']:.1f}s, temp={latest['temp_c']:.2f}C, actual PWM={latest['actual_pwm']}")
            last_log_time = time.monotonic()

        if len(samples) >= MIN_STEADY_SAMPLES:
            tail = samples[-MIN_STEADY_SAMPLES:]
            tail_start_t = tail[0]['time_s']
            tail_end_t = tail[-1]['time_s']
            if tail_end_t - tail_start_t >= STABLE_WINDOW_SECONDS:
                temps = [pt['temp_c'] for pt in tail]
                slope = (temps[-1] - temps[0]) / max(tail_end_t - tail_start_t, 1e-9)
                spread = max(temps) - min(temps)
                if abs(slope) <= STEADY_SLOPE_LIMIT_C_PER_S and spread <= 0.25:
                    steady_temp = mean(temps)
                    actual_pwm = tail[-1]['actual_pwm']
                    print(f"Steady state reached: {steady_temp:.2f}C with actual PWM {actual_pwm}.")
                    return {
                        'direction': direction,
                        'requested_percent': target_percent,
                        'requested_pwm': requested_pwm,
                        'actual_pwm': actual_pwm,
                        'start_temp_c': start_temp_c if start_temp_c is not None else steady_temp,
                        'steady_temp_c': steady_temp,
                        'time_s': tail_end_t,
                        'wait_time_s': max(tail_end_t - samples[0]['time_s'], 0.0),
                    }

        time.sleep(0.2)

    if samples:
        tail = samples[-MIN_STEADY_SAMPLES:]
        steady_temp = mean(pt['temp_c'] for pt in tail)
        actual_pwm = tail[-1]['actual_pwm']
        print(f"Timed out; using last stable window mean {steady_temp:.2f}C with actual PWM {actual_pwm}.")
        return {
            'direction': direction,
            'requested_percent': target_percent,
            'requested_pwm': requested_pwm,
            'actual_pwm': actual_pwm,
            'start_temp_c': start_temp_c if start_temp_c is not None else steady_temp,
            'steady_temp_c': steady_temp,
            'time_s': tail[-1]['time_s'],
            'wait_time_s': max(tail[-1]['time_s'] - samples[0]['time_s'], 0.0),
        }

    return {
        'direction': direction,
        'requested_percent': target_percent,
        'requested_pwm': requested_pwm,
        'actual_pwm': requested_pwm,
        'start_temp_c': start_temp_c,
        'steady_temp_c': float('nan'),
        'time_s': float('nan'),
        'wait_time_s': 0.0,
    }


def save_summary_csv(results):
    """Write a lab-table style CSV summary matching the expected worksheet format."""
    rows = []
    for direction in DIRECTIONS:
        for percent in STEADY_PERCENTAGES:
            match = next((row for row in results if row['direction'] == direction and row['requested_percent'] == percent), None)
            if match is None:
                continue
            rows.append({
                'Direction': direction,
                'PWM': match['actual_pwm'],
                'Start Temperature (°C)': match.get('start_temp_c', ''),
                'Steady Temperature (°C)': match.get('steady_temp_c', ''),
                'Time Waited (s)': match.get('wait_time_s', 0.0),
                'Notes': '',
            })

    with open(SUMMARY_FILENAME, 'w', newline='') as csv_file:
        writer = csv.DictWriter(csv_file, fieldnames=['Direction', 'PWM', 'Start Temperature (°C)', 'Steady Temperature (°C)', 'Time Waited (s)', 'Notes'])
        writer.writeheader()
        writer.writerows(rows)

    print(f"Saved summary table to {SUMMARY_FILENAME}")
    return rows


def summarize_existing_csv(path=CSV_STEADY_FILENAME):
    """Read the saved scan CSV and generate the lab-sheet summary table from it."""
    results = []
    with open(path, newline='') as csv_file:
        reader = csv.DictReader(csv_file)
        for row in reader:
            results.append({
                'direction': row['direction'],
                'requested_percent': int(float(row['requested_percent'])),
                'requested_pwm': int(float(row['requested_pwm'])),
                'actual_pwm': int(float(row['actual_pwm'])),
                'start_temp_c': float(row['start_temp_c']) if row.get('start_temp_c') not in ('', None) else float('nan'),
                'steady_temp_c': float(row['steady_temp_c']) if row.get('steady_temp_c') not in ('', None) else float('nan'),
                'time_s': float(row['time_s']) if row.get('time_s') not in ('', None) else float('nan'),
                'wait_time_s': float(row['wait_time_s']) if row.get('wait_time_s') not in ('', None) else 0.0,
            })
    save_summary_csv(results)
    return results


def run_steady_state_scan():
    """Run the requested 0,25,50,75,100% scan for heating and cooling and save the results."""
    ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=0.2)
    time.sleep(2.0)
    ser.reset_input_buffer()
    ser.flush()
    print(f'Connected to {SERIAL_PORT} at {BAUD_RATE} baud')

    results = []
    try:
        for direction in DIRECTIONS:
            for percent in STEADY_PERCENTAGES:
                result = wait_for_steady_state(ser, direction, percent)
                results.append(result)
                print(result)
                time.sleep(1.0)

        with open(CSV_STEADY_FILENAME, 'w', newline='') as csv_file:
            writer = csv.writer(csv_file)
            writer.writerow(['direction', 'requested_percent', 'requested_pwm', 'actual_pwm', 'start_temp_c', 'steady_temp_c', 'time_s', 'wait_time_s'])
            for row in results:
                writer.writerow([
                    row['direction'],
                    row['requested_percent'],
                    row['requested_pwm'],
                    row['actual_pwm'],
                    row.get('start_temp_c', ''),
                    row.get('steady_temp_c', ''),
                    row.get('time_s', ''),
                    row.get('wait_time_s', 0.0),
                ])

        print(f"Saved steady-state scan to {CSV_STEADY_FILENAME}")
        save_summary_csv(results)
        return results
    finally:
        try:
            ser.close()
        except Exception:
            pass


