        self.pwm_plot.setYRange(0, 260)
        self.pwm_plot.showGrid(x=True, y=True)

        self.pwm_heat_curve = self.pwm_plot.plot(pen=pg.mkPen('r', width=2.5), connect='finite')
        self.pwm_cool_curve = self.pwm_plot.plot(pen=pg.mkPen('b', width=2.5), connect='finite')
        self.chart_tabs.addTab(self.pwm_plot, "PWM")

        self.direction_plot = pg.PlotWidget(title="Direction vs. Arduino Time")
        self.direction_plot.setLabel('left', "Direction")
        self.direction_plot.setLabel('bottom', "Time", units="s")
        self.direction_plot.setYRange(-0.2, 1.2)
        self.direction_plot.getAxis('left').setTicks([[(0, 'COOL'), (1, 'HEAT')]])
        self.direction_plot.showGrid(x=True, y=True)
        self.direction_curve = self.direction_plot.plot(pen=pg.mkPen('k', width=2), symbol='o', symbolSize=4)
        self.chart_tabs.addTab(self.direction_plot, "Direction")

        self.error_plot = pg.PlotWidget(title="Setpoint Error vs. Arduino Time")
        self.error_plot.setLabel('left', "Error", units="°C")
        self.error_plot.setLabel('bottom', "Time", units="s")
        self.error_plot.showGrid(x=True, y=True)
        self.error_curve = self.error_plot.plot(pen=pg.mkPen('m', width=2))
        self.chart_tabs.addTab(self.error_plot, "Error")
        main_layout.addWidget(self.chart_tabs, 1)

        # Serial check timer
        self.timer = QTimer()
        self.timer.timeout.connect(self.read_serial_data)
        self.timer.start(UPDATE_INTERVAL_MS)

        # Automatic sweep state
        self.auto_sweep_sequence = list(AUTO_SWEEP_SEQUENCE)
        self.auto_sweep_index = 0
        self.auto_sweep_timer = None
        self.auto_sweep_results = []
        self.auto_sweep_step_start = None
        self.auto_sweep_step_temp = None

        if auto_run:
            self.start_auto_sweep()

    def _on_control_mode_changed(self):
        p_only = self.radio_p_only.isChecked()
        self.pwm_slider.setEnabled(not p_only)
        self.pwm_spin.setEnabled(not p_only)
        self.radio_heat.setEnabled(not p_only)
        self.radio_cool.setEnabled(not p_only)
        self.setpoint_spin.setEnabled(p_only)
        self.kp_spin.setEnabled(p_only)
        self.send_command()

    def _on_p_parameter_changed(self):
        if self.radio_p_only.isChecked():
            self.send_command()

    def send_command(self):
        """Send manual or P-controller PWM and direction to the Arduino."""
        if self.radio_p_only.isChecked():
            if self.last_temp_c is None:
                pwm_val, direction = 0, "HEAT"
            else:
                error, direction, pwm_val = calculate_p_control(
                    self.last_temp_c,
                    self.setpoint_spin.value(),
                    self.kp_spin.value(),
                )
                self.lbl_error.setText(f"Error: {error:.2f} °C")
        else:
            pwm_val = self.pwm_slider.value()
            direction = "HEAT" if self.radio_heat.isChecked() else "COOL"

        if not self.shutdown_latched:
            self.saved_pwm_value = pwm_val

        if self.auto_shutdown.isChecked() and self.shutdown_latched:
            pwm_val = 0

        self.lbl_pwm.setText(f"PWM: {pwm_val}")
        self.lbl_dir.setText(f"Dir: {direction}")

        command_str = f"SET PWM {pwm_val} DIR {direction}\n"
        if self.ser and self.ser.is_open:
            self.ser.write(command_str.encode('utf-8'))

    def read_serial_data(self):
        """Parses incoming measurement lines, logs CSV, and updates displays/plots."""
        if not self.ser or not self.ser.is_open:
            return

        while self.ser.in_waiting > 0:
            try:
                line = self.ser.readline().decode('utf-8', errors='ignore').strip()
            except Exception:
                continue

            match = LINE_PATTERN.match(line)
            if not match:
                continue

            temp_c = float(match.group(1))
            time_s = float(match.group(2))
            pwm = int(match.group(3))
            heat_cool = int(match.group(4))
            self.last_temp_c = temp_c
            self.last_pwm_value = pwm

            error = self.setpoint_spin.value() - temp_c
            self.lbl_error.setText(f"Error: {error:.2f} °C")

            if self.auto_shutdown.isChecked():
                if temp_c >= self.SHUTDOWN_TEMP_C:
                    if not self.shutdown_latched:
                        self.shutdown_latched = True
                        self.saved_pwm_value = self.pwm_slider.value()
                        print(f"Temperature reached {self.SHUTDOWN_TEMP_C}°C; PWM locked to 0 until it drops below {self.RECOVERY_TEMP_C}°C.")
                    self.pwm_slider.setValue(0)
                elif temp_c <= self.RECOVERY_TEMP_C and self.shutdown_latched:
                    self.shutdown_latched = False
                    restore_value = self.saved_pwm_value
                    self.pwm_slider.setValue(restore_value)
                    print(f"Temperature dropped below {self.RECOVERY_TEMP_C}°C; PWM restored to {restore_value}.")

            if self.radio_p_only.isChecked():
                self.send_command()

            # Print exact formatted line to terminal
            print(f"Temperature (C): {temp_c:.2f}, Time (s): {time_s:.2f}, PWM: {pwm}, Heat/Cool: {heat_cool}")

            # Update CSV
            self.csv_writer.writerow([time_s, temp_c, pwm, heat_cool])
            self.csv_file.flush()

            # Update Live Status Labels
            self.lbl_time.setText(f"Time: {time_s:.2f} s")
            self.lbl_temp.setText(f"Temp: {temp_c:.2f} °C")

            # Store Plot Data
            self.time_data.append(time_s)
            self.temp_data.append(temp_c)
            self.setpoint_data.append(self.setpoint_spin.value())
            self.error_data.append(error)
            self.direction_data.append(heat_cool)

            # Split by direction so the graph shows red for heating and blue for cooling.
            if heat_cool == 1:
                self.pwm_heat_data.append(pwm)
                self.pwm_cool_data.append(np.nan)
            else:
                self.pwm_heat_data.append(np.nan)
                self.pwm_cool_data.append(pwm)

            # Apply rolling window
            cutoff = time_s - WINDOW_DURATION
            while self.time_data and self.time_data[0] < cutoff:
                self.time_data.pop(0)
                self.temp_data.pop(0)
                self.setpoint_data.pop(0)
                self.error_data.pop(0)
                self.direction_data.pop(0)
                self.pwm_heat_data.pop(0)
                self.pwm_cool_data.pop(0)

            # Redraw Plots
            self.temp_curve.setData(self.time_data, self.temp_data)
            self.setpoint_curve.setData(self.time_data, self.setpoint_data)
            self.pwm_heat_curve.setData(self.time_data, self.pwm_heat_data)
            self.pwm_cool_curve.setData(self.time_data, self.pwm_cool_data)
            self.direction_curve.setData(self.time_data, self.direction_data)
            self.error_curve.setData(self.time_data, self.error_data)

            self.temp_plot.setXRange(max(0.0, cutoff), max(WINDOW_DURATION, time_s))
            self.pwm_plot.setXRange(max(0.0, cutoff), max(WINDOW_DURATION, time_s))
            self.direction_plot.setXRange(max(0.0, cutoff), max(WINDOW_DURATION, time_s))
            self.error_plot.setXRange(max(0.0, cutoff), max(WINDOW_DURATION, time_s))

    def start_auto_sweep(self):
        """Run the full steady-state sweep automatically while keeping the live chart visible."""
        self.auto_sweep_results = []
        self.auto_sweep_index = 0
        self._run_next_auto_step()

    def _run_next_auto_step(self):
        if self.auto_sweep_index >= len(self.auto_sweep_sequence):
            self._finish_auto_sweep()
            return

        direction, percent = self.auto_sweep_sequence[self.auto_sweep_index]
        requested_pwm = int(round((percent / 100.0) * 255))
        self.radio_heat.setChecked(direction == 'HEAT')
        self.radio_cool.setChecked(direction == 'COOL')
        self.pwm_slider.setValue(requested_pwm)
        self.send_command()

        self.auto_sweep_step_start = time.monotonic()
        self.auto_sweep_step_temp = self.last_temp_c
        self.auto_sweep_timer = QTimer(self)
        self.auto_sweep_timer.setSingleShot(True)
        self.auto_sweep_timer.timeout.connect(self._capture_auto_step_result)
        self.auto_sweep_timer.start(int(AUTO_SWEEP_SECONDS * 1000))

    def _capture_auto_step_result(self):
        direction, percent = self.auto_sweep_sequence[self.auto_sweep_index]
        requested_pwm = int(round((percent / 100.0) * 255))
        actual_pwm = self.last_pwm_value if self.last_pwm_value is not None else self.pwm_slider.value()

        temp_value = self.last_temp_c if self.last_temp_c is not None else float('nan')
        self.auto_sweep_results.append({
            'direction': direction,
            'requested_percent': percent,
            'requested_pwm': requested_pwm,
            'actual_pwm': actual_pwm,
            'steady_temp_c': temp_value,
            'time_s': time.monotonic() - self.auto_sweep_step_start if self.auto_sweep_step_start is not None else 0.0,
        })

        print(f"Auto-sweep step complete: {direction} @ {percent}% -> actual PWM {actual_pwm}, steady temp {temp_value:.2f}C")
        self.auto_sweep_index += 1
        self._run_next_auto_step()

    def _finish_auto_sweep(self):
        if not self.auto_sweep_results:
            return

        with open(CSV_STEADY_FILENAME, 'w', newline='') as csv_file:
            writer = csv.writer(csv_file)
            writer.writerow(['direction', 'requested_percent', 'requested_pwm', 'actual_pwm', 'steady_temp_c', 'time_s'])
            for row in self.auto_sweep_results:
                writer.writerow([
                    row['direction'],
                    row['requested_percent'],
                    row['requested_pwm'],
                    row['actual_pwm'],
                    row['steady_temp_c'],
                    row['time_s'],
                ])

        print(f"Saved automatic sweep results to {CSV_STEADY_FILENAME}")

    def closeEvent(self, event):
        if self.ser and self.ser.is_open:
            self.ser.close()
        if self.csv_file and not self.csv_file.closed:
            self.csv_file.close()
        event.accept()


if __name__ == '__main__':
    if len(sys.argv) > 1 and sys.argv[1].lower() == '--steady':
        run_steady_state_scan()
    elif len(sys.argv) > 1 and sys.argv[1].lower() == '--summary':
        summarize_existing_csv()
    elif len(sys.argv) > 1 and sys.argv[1].lower() == '--auto-sweep':
        app = QApplication(sys.argv)
        window = TECControlGUI(auto_run=True)
        window.show()
        sys.exit(app.exec())
    else:
        app = QApplication(sys.argv)
        window = TECControlGUI()
        window.show()
        sys.exit(app.exec())



import glob
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# Load all 10 run files and plot each trace individually.
file_paths = sorted(glob.glob("run_*.csv"))
if len(file_paths) < 1:
    raise FileNotFoundError("No run_*.csv files found in the current directory.")

runs_data = []
for path in file_paths[:10]:
    df = pd.read_csv(path)
    if "value" not in df.columns:
        raise ValueError(f"Expected a 'value' column in {path}, but it was not found.")
    runs_data.append(df["value"].to_numpy())

traces = np.array(runs_data)
steps = np.arange(traces.shape[1])

plt.figure(figsize=(12, 7))
for i, trace in enumerate(traces):
    plt.plot(steps, trace, alpha=0.5, linewidth=1.5, label=f"Run {i+1}")

mean_trace = np.mean(traces, axis=0)
std_trace = np.std(traces, axis=0)
plt.plot(steps, mean_trace, color="black", linewidth=2.5, label="Mean Trace")
plt.fill_between(
    steps,
    mean_trace - std_trace,
    mean_trace + std_trace,
    color="black",
    alpha=0.15,
    label="±1 Std Dev",
)

plt.xlabel("Step / Time")
plt.ylabel("Value / Metric")
plt.title("All 10 Run Traces with Mean and Std Dev")
plt.legend(loc="best")
plt.grid(True, linestyle="--", alpha=0.5)
plt.tight_layout()
plt.show()